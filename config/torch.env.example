# Optional settings. Created automatically from this example on first use; edit only to override.
# Sourced by install.sh / run.sh and the Slurm jobs (bash).

# Slurm account. Leave empty to use the project account in config/runtime.yaml (torch_pr_742_general).
SLURM_ACCOUNT=""

# The repo location is detected automatically (any folder name). Torch storage policy: keep the
# clone in $HOME (backed up), not /scratch (not backed up, purged after 60 days).

# Large, rebuildable data: SIFs, Kit/shader caches, localized assets, raw run directories.
# ./install.sh recreates everything here from pinned sources after a purge.
NCR_SCRATCH="/scratch/${USER}/ncr_work"

# E-mail on job END/FAIL goes to <netid>@nyu.edu (as in Go2). Set to use another address.
MAIL_USER=""

# Only needed if the anonymous pull of nvcr.io/nvidia/isaac-sim:5.1.0 is denied.
# Never commit a real key. install.slurm hands it to apptainer without echoing it.
NGC_API_KEY=""
