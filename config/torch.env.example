# Copy to config/torch.env on Torch (git-ignored) and fill in.
# Sourced by install.sh / run.sh and the Slurm jobs (bash).

# Active Torch Slurm account: run `my_slurm_accounts` on a login node.
SLURM_ACCOUNT=torch_pr_XXXX_XXXXX

# Git checkout of this repo. Torch storage policy: keep source code in $HOME (backed up),
# not in /scratch (not backed up, purged after 60 days). Jobs snapshot its committed HEAD.
WF_REPO="${HOME}/wildfire"

# Large, rebuildable data: SIFs, Kit/shader caches, localized assets, raw run directories.
# ./install.sh recreates everything here from pinned sources after a purge.
WF_SCRATCH="/scratch/${USER}/wildfire_work"

# Optional: e-mail on job END/FAIL (Slurm --mail-type/--mail-user).
MAIL_USER=""

# Only needed if the anonymous pull of nvcr.io/nvidia/isaac-sim:5.1.0 is denied.
# Never commit a real key. install.slurm hands it to apptainer without echoing it.
NGC_API_KEY=""
